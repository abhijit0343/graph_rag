# =====================================================
# Git Ignore - GraphRAG Local Intelligence
# =====================================================

# Environment variables & secrets (NEVER commit secrets or API keys)
.env
.env.*
!.env.example

# Python virtual environment & bytecode
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# LLM Disk Cache & Local Ingestion Artifacts
.cache/
models/.cache/
data/uploads/*
!data/uploads/.gitkeep
data/storage/*
!data/storage/.gitkeep

# LangSmith & Evaluation Cache
eval_results_*.json

# Node & Frontend dependencies & bundles
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System & IDE
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.gemini/
.system_generated/
